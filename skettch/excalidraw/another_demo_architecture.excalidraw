    {"id":"n4","type":"text","x":120,"y":1030,"width":900,"height":28,"text":"AST inheritance / ownership: MessageAST and ParamNode derive from ASTNode; MessageAST owns params and deletes them","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#dc2626","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":404,"version":1,"versionNonce":404,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
