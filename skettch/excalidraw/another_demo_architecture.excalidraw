    {"id":"t2","type":"text","x":110,"y":358,"width":480,"height":235,"text":"class Server\nrole: owns the event loop, listening fd, users and dispatcher\n\n- _port: int\n- _isRunning: bool\n- _serverFd: int\n- _users: map<int, User*>\n- _pollFds: vector<pollfd>\n- _dispatcher: CommandDispatcher\n\nstart(), stop(), initServer(), acceptClient()\nhandleClientData(), removeClient()\naddUser(), removeUser(), getUserByNick()","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":304,"version":1,"versionNonce":304,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"r3","type":"rectangle","x":700,"y":340,"width":340,"height":270,"strokeColor":"#1e1e1e","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":305,"version":1,"versionNonce":305,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t3","type":"text","x":720,"y":358,"width":300,"height":235,"text":"class CommandDispatcher\nrole: maps IRC commands to handlers\n\n- _handlers: map<string, CommandHandler>\n\nCommandHandler = void (*)(\n  Server&, User&, const MessageAST&)\n\ndispatch()\nhandleNick(), handleUser()\nhandlePing(), handlePrivMsg()","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":306,"version":1,"versionNonce":306,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"r4","type":"rectangle","x":1080,"y":340,"width":360,"height":270,"strokeColor":"#1e1e1e","backgroundColor":"#dcfce7","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":307,"version":1,"versionNonce":307,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t4","type":"text","x":1100,"y":358,"width":320,"height":235,"text":"class User\nrole: stores one connected client's identity and socket\n\n- _id: int\n- _nickname: string\n- _username: string\n- _realname: string\n- _hostname: string\n- _socket: ISocket*\n- _isAuth: bool\n\ngetters; setNickname(), setUsername()\nsetRealname(), setHostname()\nsetAuthenticated()","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":308,"version":1,"versionNonce":308,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"r5","type":"rectangle","x":1080,"y":640,"width":360,"height":170,"strokeColor":"#1e1e1e","backgroundColor":"#f3e8ff","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":309,"version":1,"versionNonce":309,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t5","type":"text","x":1100,"y":658,"width":320,"height":140,"text":"interface ISocket\nrole: abstract send/receive API\n\n(no data members)\nvirtual getFd(), send(), receive()\n\nUser::_socket points here;\nServer calls receive/send through it.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":310,"version":1,"versionNonce":310,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"r6","type":"rectangle","x":90,"y":860,"width":340,"height":150,"strokeColor":"#1e1e1e","backgroundColor":"#ede9fe","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":311,"version":1,"versionNonce":311,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t6","type":"text","x":110,"y":878,"width":300,"height":120,"text":"class TCPSocket : ISocket\nrole: concrete POSIX socket adapter\n\n- _fd: int\ngetFd(), send(), receive()\n~TCPSocket() closes _fd if >= 0","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":312,"version":1,"versionNonce":312,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"r7","type":"rectangle","x":450,"y":860,"width":340,"height":150,"strokeColor":"#1e1e1e","backgroundColor":"#ffedd5","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":313,"version":1,"versionNonce":313,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t7","type":"text","x":470,"y":878,"width":300,"height":120,"text":"class Lexer\nrole: converts raw IRC text to tokens\n\n- _src: string\n- _index: size_t\nisAtEnd(), peek(), advance()\nskipWhitespace(), readUntil()\ntokenize(): vector<Token>","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":314,"version":1,"versionNonce":314,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"r8","type":"rectangle","x":810,"y":860,"width":340,"height":150,"strokeColor":"#1e1e1e","backgroundColor":"#ffedd5","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":315,"version":1,"versionNonce":315,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t8","type":"text","x":830,"y":878,"width":300,"height":120,"text":"class ASTParser\nrole: converts tokens to MessageAST\n\n- _tokens: vector<Token>\n- _index: size_t\nisAtEnd(), peekToken(), advanceToken()\nparsePrefix(), parseCmd(), parseParams()\nparse(): MessageAST*","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":316,"version":1,"versionNonce":316,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"r9","type":"rectangle","x":1170,"y":860,"width":340,"height":150,"strokeColor":"#1e1e1e","backgroundColor":"#fef9c3","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":317,"version":1,"versionNonce":317,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t9","type":"text","x":1190,"y":878,"width":300,"height":120,"text":"struct Token\nenum TokenType\nrole: one lexical IRC item\n\n- type: TokenType\n- value: string\n\nTokenType: PREFIX, COMMAND,\nPARAMETER, TRAILING, END_OF_LINE","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":318,"version":1,"versionNonce":318,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"r10","type":"rectangle","x":450,"y":1100,"width":340,"height":170,"strokeColor":"#1e1e1e","backgroundColor":"#fef9c3","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":319,"version":1,"versionNonce":319,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t10","type":"text","x":470,"y":1118,"width":300,"height":140,"text":"struct ASTNode\nrole: polymorphic AST base\n(no data members)\n\nstruct ParamNode : ASTNode\n- value: string\n- isTrailing: bool\n\nParamNode is deleted by MessageAST.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":320,"version":1,"versionNonce":320,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"r11","type":"rectangle","x":810,"y":1100,"width":340,"height":170,"strokeColor":"#1e1e1e","backgroundColor":"#fef9c3","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":321,"version":1,"versionNonce":321,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t11","type":"text","x":830,"y":1118,"width":300,"height":140,"text":"struct MessageAST : ASTNode\nrole: parsed IRC message\n\n- prefix: string\n- command: string\n- params: vector<ParamNode*>\n\nDestructor deletes every params[i].\nDispatcher reads command and params.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":322,"version":1,"versionNonce":322,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"n1","type":"text","x":1130,"y":516,"width":300,"height":24,"text":"_socket -> ISocket API","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#16a34a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":401,"version":1,"versionNonce":401,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"n2","type":"text","x":590,"y":524,"width":460,"height":24,"text":"handleClientData: raw bytes -> Lexer -> tokens -> ASTParser -> AST","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#2563eb","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":402,"version":1,"versionNonce":402,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
