    {"id":"t1","type":"text","x":200,"y":158,"width":300,"height":64,"text":"main / signalHandler\nlocals: argc, argv, port, server\nglobalServer: Server*","fontSize":17,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":302,"version":1,"versionNonce":302,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

