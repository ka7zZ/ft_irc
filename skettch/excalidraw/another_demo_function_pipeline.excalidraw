    {"id":"r1","type":"rectangle","x":60,"y":120,"width":480,"height":100,"strokeColor":"#2563eb","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":20,"version":1,"versionNonce":20,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t1","type":"text","x":82,"y":138,"width":436,"height":64,"text":"main(argc, argv)\natoi(argv[1]) -> Server::Server(port) -> Server::start()\nserver.start() is the single event-loop owner.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":21,"version":1,"versionNonce":21,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"r2","type":"rectangle","x":60,"y":270,"width":480,"height":100,"strokeColor":"#2563eb","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":22,"version":1,"versionNonce":22,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t2","type":"text","x":82,"y":288,"width":436,"height":64,"text":"Server::start() -> initServer()\nsocket() -> setsockopt() -> memset() -> bind()\nlisten() -> fcntl() -> pollFds.push_back()","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":23,"version":1,"versionNonce":23,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"r3","type":"rectangle","x":60,"y":420,"width":480,"height":100,"strokeColor":"#2563eb","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":24,"version":1,"versionNonce":24,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t3","type":"text","x":82,"y":438,"width":436,"height":64,"text":"poll(&_pollFds[0], _pollFds.size(), -1)\nPOLLIN on server fd -> Server::acceptClient()\naccept() -> fcntl() -> TCPSocket::TCPSocket(fd) -> User::User(fd, socket)","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":25,"version":1,"versionNonce":25,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"r4","type":"rectangle","x":60,"y":570,"width":480,"height":100,"strokeColor":"#2563eb","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":26,"version":1,"versionNonce":26,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t4","type":"text","x":82,"y":588,"width":436,"height":64,"text":"POLLIN on client fd -> Server::handleClientData(fd)\nUser::getSocket() -> ISocket::receive(buffer, 1023)\nbytesRead <= 0 -> Server::removeClient(fd)","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":27,"version":1,"versionNonce":27,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"r5","type":"rectangle","x":60,"y":720,"width":480,"height":100,"strokeColor":"#2563eb","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":28,"version":1,"versionNonce":28,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t5","type":"text","x":82,"y":738,"width":436,"height":64,"text":"Lexer::Lexer(rawData) -> tokenize()\nisAtEnd() -> peek() -> advance() -> skipWhitespace()\nreadUntil() -> Token; tokenize() returns vector<Token>","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":29,"version":1,"versionNonce":29,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"r6","type":"rectangle","x":60,"y":870,"width":480,"height":100,"strokeColor":"#2563eb","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":30,"version":1,"versionNonce":30,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t6","type":"text","x":82,"y":888,"width":436,"height":64,"text":"ASTParser::ASTParser(tokens) -> parse()\nisAtEnd() -> peekToken() -> advanceToken()\nparsePrefix() -> parseCmd() -> parseParams() -> MessageAST*","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":31,"version":1,"versionNonce":31,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"r7","type":"rectangle","x":60,"y":1020,"width":480,"height":100,"strokeColor":"#2563eb","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":32,"version":1,"versionNonce":32,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t7","type":"text","x":82,"y":1038,"width":436,"height":64,"text":"CommandDispatcher::dispatch(server, user, ast)\n_handlers.find(ast.command) -> handler(server, user, ast)\nAfter each command, handleClientData deletes ast.","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":33,"version":1,"versionNonce":33,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"ra","type":"rectangle","x":650,"y":120,"width":470,"height":115,"strokeColor":"#16a34a","backgroundColor":"#dcfce7","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":40,"version":1,"versionNonce":40,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"ta","type":"text","x":672,"y":138,"width":426,"height":78,"text":"Client A: NICK alice\\r\\n\nhandleNick(server, user, ast)\nparams.empty()? false -> User::setNickname(ast.params[0]->value)","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":41,"version":1,"versionNonce":41,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"ra2","type":"rectangle","x":650,"y":270,"width":470,"height":115,"strokeColor":"#16a34a","backgroundColor":"#dcfce7","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":42,"version":1,"versionNonce":42,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"ta2","type":"text","x":672,"y":288,"width":426,"height":78,"text":"Client A: USER alice 0 * :Alice\\r\\n\nhandleUser(server, user, ast)\nparams.empty()? false -> User::setUsername(ast.params[0]->value)","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":43,"version":1,"versionNonce":43,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"rb","type":"rectangle","x":650,"y":420,"width":470,"height":115,"strokeColor":"#ea580c","backgroundColor":"#ffedd5","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":44,"version":1,"versionNonce":44,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"tb","type":"text","x":672,"y":438,"width":426,"height":78,"text":"Client B: NICK bob\\r\\n\nhandleNick(server, user, ast)\nparams.empty()? false -> User::setNickname(ast.params[0]->value)","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":45,"version":1,"versionNonce":45,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"rb2","type":"rectangle","x":650,"y":570,"width":470,"height":115,"strokeColor":"#ea580c","backgroundColor":"#ffedd5","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":46,"version":1,"versionNonce":46,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"tb2","type":"text","x":672,"y":588,"width":426,"height":78,"text":"Client B: USER bob 0 * :Bob\\r\\n\nhandleUser(server, user, ast)\nparams.empty()? false -> User::setUsername(ast.params[0]->value)","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":47,"version":1,"versionNonce":47,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"rp1","type":"rectangle","x":650,"y":720,"width":470,"height":145,"strokeColor":"#9333ea","backgroundColor":"#f3e8ff","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":48,"version":1,"versionNonce":48,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"tp1","type":"text","x":672,"y":738,"width":426,"height":109,"text":"Client A: PRIVMSG bob :Hello Bob!\\r\\n\nhandlePrivMsg(server, alice, ast)\nparams.size() < 2? false\ntarget = params[0], msg = params[1]\ntarget[0] == '#' ? false -> private path","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":49,"version":1,"versionNonce":49,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"rp2","type":"rectangle","x":650,"y":900,"width":470,"height":145,"strokeColor":"#9333ea","backgroundColor":"#f3e8ff","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":50,"version":1,"versionNonce":50,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"tp2","type":"text","x":672,"y":918,"width":426,"height":109,"text":"Server::getUserByNick(\"bob\")\nUser::getNickname() for each _users entry\ntargetUser != NULL -> User::getSocket()\nISocket::send(fullMessage, length)","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":51,"version":1,"versionNonce":51,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"rp3","type":"rectangle","x":650,"y":1080,"width":470,"height":145,"strokeColor":"#9333ea","backgroundColor":"#f3e8ff","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"angle":0,"seed":52,"version":1,"versionNonce":52,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"tp3","type":"text","x":672,"y":1098,"width":426,"height":109,"text":"TCPSocket::send() -> ::send(fd, data, size, 0)\nB receives [PRIVATE MESSAGE from (alice)]: Hello Bob!\nThen B can repeat: handlePrivMsg -> lookup alice -> send.\nExample: PRIVMSG alice :Hi Alice!\\r\\n","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":53,"version":1,"versionNonce":53,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},

    {"id":"c1","type":"rectangle","x":1180,"y":120,"width":570,"height":205,"strokeColor":"#dc2626","backgroundColor":"#fef2f2","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":1,"opacity":100,"angle":0,"seed":60,"version":1,"versionNonce":60,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"ct1","type":"text","x":1205,"y":140,"width":520,"height":165,"text":"Why params.empty()?\nThe handler reads params[0], so it must prove that element exists.\nPass: NICK alice\\r\\n -> [\"alice\"] -> setNickname().\nAlternative: NICK\\r\\n -> [] -> return safely; nickname unchanged.\nSame rule: USER bob 0 * :Bob vs USER\\r\\n.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#991b1b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":61,"version":1,"versionNonce":61,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"c2","type":"rectangle","x":1180,"y":350,"width":570,"height":220,"strokeColor":"#dc2626","backgroundColor":"#fef2f2","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":1,"opacity":100,"angle":0,"seed":62,"version":1,"versionNonce":62,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"ct2","type":"text","x":1205,"y":370,"width":520,"height":180,"text":"Why params.size() < 2?\nPRIVMSG needs target=params[0] and text=params[1].\nPass: PRIVMSG bob :Hello Bob!\\r\\n.\nAlternative A: PRIVMSG bob\\r\\n -> size 1 -> reject, no out-of-range read.\nAlternative B: PRIVMSG bob :Hello there friend\\r\\n.\nThe colon makes one TRAILING token, preserving spaces.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#991b1b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":63,"version":1,"versionNonce":63,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"c3","type":"rectangle","x":1180,"y":595,"width":570,"height":220,"strokeColor":"#dc2626","backgroundColor":"#fef2f2","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":1,"opacity":100,"angle":0,"seed":64,"version":1,"versionNonce":64,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"ct3","type":"text","x":1205,"y":615,"width":520,"height":180,"text":"Why target[0] == '#' ?\n#channel is a different destination type from a nickname.\nPrivate: PRIVMSG bob :Hi\\r\\n -> getUserByNick(\"bob\").\nAlternative: PRIVMSG #general :Hi all\\r\\n -> channel branch.\nCurrent source only prints a placeholder because Channel is not implemented.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#991b1b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":65,"version":1,"versionNonce":65,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"c4","type":"rectangle","x":1180,"y":840,"width":570,"height":220,"strokeColor":"#dc2626","backgroundColor":"#fef2f2","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":1,"opacity":100,"angle":0,"seed":66,"version":1,"versionNonce":66,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"ct4","type":"text","x":1205,"y":860,"width":520,"height":180,"text":"Why targetUser != NULL?\nA nickname may not exist; do not call getSocket() on NULL.\nFound: PRIVMSG bob :Hi\\r\\n -> send to Bob.\nMissing: PRIVMSG charlie :Hi\\r\\n -> log \"Nickname unavailable.\"\nBetter alternative: send an IRC error numeric to Alice.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#991b1b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":67,"version":1,"versionNonce":67,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"note","type":"text","x":70,"y":1300,"width":1680,"height":80,"text":"Source caveat: the current code stores nickname and username but does not enforce registration before PRIVMSG and does not reject duplicate nicknames. This diagram follows the current implementation, not a completed IRC protocol policy.","fontSize":17,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#991b1b","backgroundColor":"#fef2f2","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"angle":0,"seed":70,"version":1,"versionNonce":70,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false}
  ],
  "appState":{"gridSize":null,"viewBackgroundColor":"#ffffff","zoom":{"value":0.65},"scrollX":0,"scrollY":0},
  "files":{}
}
